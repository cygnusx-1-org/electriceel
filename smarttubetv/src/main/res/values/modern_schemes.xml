<?xml version="1.0" encoding="utf-8"?>
<!--
    Color schemes of the modern skin, one for each scheme of User interface > Color scheme (MainUIData),
    looked up by the scheme's id (ModernColorScheme.getOverlayResId).
    Same colors as the classic schemes (styles.xml): background, brand (expanded rail, like the classic headers),
    accent (watch progress, seek bar, live badge, voice search) and logo. Focus stays white in every scheme.
    Dark Grey is the default look, defined in Theme.Modern, Theme.Modern.Player and Theme.Modern.Preferences.
    Dark parts use one color: grey in the regular schemes, black in the OLED ones. Only a colored brand
    (Teal, Red, Electric Blue) gives the expanded rail its own color.
    The hybrid skin (ThemeOverlay.Modern.Hybrid) has behind the cards (browse, channel, search) the shelfBackground of the
    scheme's classic browse theme (modernShelfBackground, MainUIData.ColorScheme.browseThemeResId), e.g. the blue of
    Electric Blue, and the text area of its cards the colors of the classic info field (cardDefaultBackground,
    cardSelectedBackground).
-->
<resources>
    <style name="ThemeOverlay.Modern.Scheme" parent="">
        <item name="modernBackground">@color/modern_bg</item>
        <item name="modernBrand">@color/modern_bg</item>
        <item name="modernAccent">@color/modern_progress</item>
        <item name="modernLogo">@mipmap/app_logo_semi_red</item>
        <item name="modernPlayerScrimControls">@drawable/modern_player_scrim_controls</item>
        <item name="modernPlayerScrimSuggestions">@drawable/modern_player_scrim_suggestions</item>
    </style>

    <style name="ThemeOverlay.Modern.Scheme.Oled">
        <item name="modernBackground">@color/modern_bg_oled</item>
        <item name="modernBrand">@color/modern_bg_oled</item>
        <item name="modernLogo">@null</item>
        <item name="modernPlayerScrimControls">@drawable/modern_player_scrim_controls_oled</item>
        <item name="modernPlayerScrimSuggestions">@drawable/modern_player_scrim_suggestions_oled</item>
    </style>

    <!-- The hybrid skin (see HybridSkin): behind the cards the background of the classic screens in the scheme -->
    <style name="ThemeOverlay.Modern.Hybrid" parent="">
        <item name="android:windowBackground">?attr/modernShelfBackground</item>
        <!-- Drawn by the background manager over the window -->
        <item name="shelfBackground">?attr/modernShelfBackground</item>
    </style>

    <!-- The modern skin: the background of the scheme behind the cards. Applied over the theme again when the screen
         takes a picked skin before it's recreated (re-setting the same theme keeps the hybrid overlay's values) -->
    <style name="ThemeOverlay.Modern.Window" parent="">
        <item name="android:windowBackground">?attr/modernBackground</item>
        <item name="shelfBackground">?attr/modernBackground</item>
    </style>

    <!-- A screen only the classic look has, shown in the modern skin (see ModernSkin): the background of the scheme -->
    <style name="ThemeOverlay.Modern.ClassicScreen" parent="">
        <item name="android:windowBackground">?attr/modernBackground</item>
        <item name="android:colorBackground">?attr/modernBackground</item>
    </style>

    <!-- Teal -->
    <style name="ThemeOverlay.Modern.Scheme.Teal">
        <item name="cardDefaultBackground">@color/card_default_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="modernShelfBackground">@color/shelf_background_dark</item>
        <item name="modernBrand">@color/fastlane_background_dark</item>
        <item name="modernAccent">@color/fastlane_background</item>
        <item name="modernLogo">@mipmap/app_logo</item>
    </style>

    <!-- Dark Grey -->
    <style name="ThemeOverlay.Modern.Scheme.DarkGrey">
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="modernShelfBackground">@color/scheme_grey_shelf_background_dark</item>
    </style>

    <!-- Red -->
    <style name="ThemeOverlay.Modern.Scheme.Red">
        <item name="cardDefaultBackground">@color/scheme_red_card_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="modernShelfBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="modernBrand">@color/dark_red</item>
        <item name="modernAccent">@color/semi_red</item>
    </style>

    <!-- Dark Grey (OLED) -->
    <style name="ThemeOverlay.Modern.Scheme.Oled.DarkGrey">
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
        <item name="modernShelfBackground">@color/scheme_grey_shelf_background_dark</item>
    </style>

    <!-- Teal (OLED) -->
    <style name="ThemeOverlay.Modern.Scheme.Oled.Teal">
        <item name="cardDefaultBackground">@color/card_default_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="modernShelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="modernBrand">@color/fastlane_background_dark</item>
        <item name="modernAccent">@color/fastlane_background</item>
    </style>

    <!-- Dark Grey (monochrome) -->
    <style name="ThemeOverlay.Modern.Scheme.Monochrome">
        <item name="cardDefaultBackground">@color/grey</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
        <item name="modernShelfBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="modernAccent">@color/light_grey</item>
        <item name="modernLogo">@mipmap/app_logo_semi_grey</item>
    </style>

    <!-- Dark Blue -->
    <style name="ThemeOverlay.Modern.Scheme.Blue">
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="modernShelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="modernAccent">@color/scheme_blue_background</item>
        <item name="modernLogo">@mipmap/app_logo</item>
    </style>

    <!-- Electric Blue (the default scheme of Electric Eel) -->
    <style name="ThemeOverlay.Modern.Scheme.ElectricBlue">
        <item name="cardDefaultBackground">@color/scheme_electric_blue_card_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="modernShelfBackground">@color/scheme_electric_blue_shelf_background_dark</item>
        <item name="modernBrand">@color/scheme_electric_blue_background_dark</item>
        <item name="modernAccent">@color/scheme_electric_blue</item>
        <item name="modernLogo">@mipmap/app_logo</item>
    </style>

    <!-- Dark Blue (OLED) -->
    <style name="ThemeOverlay.Modern.Scheme.Oled.Blue">
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
        <item name="modernShelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="modernAccent">@color/scheme_blue_background</item>
    </style>
</resources>
