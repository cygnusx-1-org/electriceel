<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dialog (preference) panels: defaults in App.Theme.Leanback.Preferences.Base, modern values in Theme.Modern.Preferences -->
    <attr name="modernPrefPanelBackground" format="reference|color" />
    <attr name="modernPrefTitleBackground" format="reference|color" />
    <attr name="modernPrefItemTextColor" format="reference|color" />
    <attr name="modernPrefRadioButton" format="reference" />
    <attr name="modernPrefCheckBox" format="reference" />
    <!-- The radio buttons and checkboxes of the lists: classic the theme's own (the library's look, animations included),
         modern its drawables -->
    <attr name="modernPrefRadioButtonStyle" format="reference" />
    <attr name="modernPrefCheckBoxStyle" format="reference" />
    <!-- Icons of the rows of Electric Eel (menu arrow, reorder handle): classic none (white drawables), modern the text color -->
    <attr name="modernPrefIconTint" format="reference|color" />
    <attr name="modernPrefChatBubble" format="reference|color" />
    <attr name="modernPrefChatBubbleFocused" format="reference|color" />
    <!-- Rows of the choice lists pass their focus state to the texts and the indicator (modern: true, classic: false) -->
    <attr name="modernPrefDuplicateState" format="boolean" />
    <!-- Start offset of the choice indicators (classic: negative, to align the platform drawables) -->
    <attr name="modernPrefCheckMarginStart" format="dimension" />
    <attr name="modernPrefRadioMarginStart" format="dimension" />
    <!-- Color scheme (User interface > Color scheme): defaults in Theme.Modern*, one overlay per scheme in modern_schemes.xml -->
    <attr name="modernBackground" format="reference|color" />
    <!-- Hybrid skin, the screens with cards (browse, channel, search): the shelfBackground of the classic scheme -->
    <attr name="modernShelfBackground" format="reference|color" />
    <attr name="modernBrand" format="reference|color" />
    <attr name="modernAccent" format="reference|color" />
    <attr name="modernLogo" format="reference" />
    <attr name="modernPlayerScrimControls" format="reference" />
    <attr name="modernPlayerScrimSuggestions" format="reference" />
    <attr name="modernChannelScrim" format="reference" />
</resources>
