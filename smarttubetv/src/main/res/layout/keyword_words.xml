<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/keyword_words_padding_horizontal"
    android:paddingEnd="@dimen/keyword_words_padding_horizontal"
    android:paddingTop="@dimen/keyword_words_padding_vertical">

    <TextView
        android:id="@+id/keyword_words_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="@dimen/keyword_words_title_text_size" />

    <TextView
        android:id="@+id/keyword_words_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/keyword_words_dim_text"
        android:textSize="@dimen/keyword_words_description_text_size" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/keyword_words_letters"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyword_letter_tab_height"
        android:layout_marginTop="@dimen/keyword_words_section_spacing"
        android:clipToPadding="false" />

    <!-- Up from the first row goes back to the tabs. Left and right stay in the grid. -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/keyword_words_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/keyword_words_section_spacing"
        android:paddingBottom="@dimen/keyword_words_padding_vertical"
        android:clipToPadding="false"
        app:focusOutFront="true"
        app:focusOutSideStart="false"
        app:focusOutSideEnd="false" />

</LinearLayout>
