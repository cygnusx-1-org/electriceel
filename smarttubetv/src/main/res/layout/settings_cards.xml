<?xml version="1.0" encoding="utf-8"?>
<!-- The settings cards under their title, the same on every screen that has them (see SettingsCardsLayout). The grid of the
     fragment goes under the title: it fills the screen, its padding places the cards (see Widget.Leanback.GridItems.VerticalGridView).
     The title sits in the top padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Starts where the first card starts -->
    <TextView
        android:id="@+id/settings_cards_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/browsePaddingStart"
        android:paddingEnd="?attr/browsePaddingEnd"
        android:paddingTop="?attr/browsePaddingTop"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:textSize="@dimen/keyword_words_title_text_size" />

</FrameLayout>
